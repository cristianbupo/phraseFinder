  },
  {
    "text": "digas, Gasparcín, ¿dónde está mi coche?",
    "start": 181.159,
    "duration": 2.601
  },
  {
    "text": "Espérate, Gaspar, me hierven la",
    "start": 182.56,
    "duration": 2.44
  },
