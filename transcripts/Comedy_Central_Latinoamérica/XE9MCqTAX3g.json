    "start": 113.92,
    "duration": 1.44
  },
  {
    "text": "Sí, sí, abuelo, claro.",
    "start": 114.479,
    "duration": 1.201
  },
  {
    "text": "Dilo.",
    "start": 115.36,
    "duration": 0.679
  },
  {
    "text": "¿Qué?",
