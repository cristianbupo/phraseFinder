  {
    "text": "Irmita.",
    "start": 192.239,
    "duration": 1.08
  },
  {
    "text": "¿De qué hablan?",
    "start": 192.68,
    "duration": 3.52
  },
  {
    "text": "Cállate, Jonathan.",
    "start": 193.319,
    "duration": 6.801
  },
  {
    "text": "Bueno, en serio, ahí voy, desgraciado.",
    "start": 196.2,
    "duration": 4.759
  },
  {
    "text": "¿Qué pasó, hermita?",
    "start": 200.12,
    "duration": 2.759
  },
  {
    "text": "Ya abrieron el tentáculo.",
