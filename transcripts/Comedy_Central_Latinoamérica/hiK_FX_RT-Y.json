    "duration": 2.36
  },
  {
    "text": "Cito,",
    "start": 373.28,
    "duration": 3.759
  },
  {
    "text": "esperante, envidioso, hipócrita, falso,",
    "start": 374.8,
    "duration": 4.48
  },
  {
    "text": "manipulador, oportunista, interesado,",
    "start": 377.039,
    "duration": 2.88
  },
  {
    "text": "vulgar,",
    "start": 379.28,
