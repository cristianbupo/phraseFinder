[
  {
    "text": "Harás la prueba de Asociación de",
    "start": 0.24,
    "duration": 4.039
  },
  {
    "text": "palabras. Voy a decir una palabra y",
    "start": 2.04,
    "duration": 3.64
  },
  {
    "text": "quiero que digas lo primero que se te",
    "start": 4.279,
    "duration": 2.321
  },
  {
    "text": "venga a la mente.",
    "start": 5.68,
    "duration": 1.84
