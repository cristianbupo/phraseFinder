    "start": 88.72,
    "duration": 3.6
  },
  {
    "text": "¿De qué chingadas hablas?",
    "start": 91.159,
    "duration": 2.28
  },
  {
    "text": "Eh, no, nada, olvido.",
    "start": 92.32,
    "duration": 2.799
  },
