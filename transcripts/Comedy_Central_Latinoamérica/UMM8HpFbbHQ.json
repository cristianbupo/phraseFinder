  },
  {
    "text": "detención?",
    "start": 235.079,
    "duration": 3.281
  },
  {
    "text": "Detención ahora, detención mañana,",
    "start": 236.239,
    "duration": 5.64
  },
  {
    "text": "detención siempre.",
    "start": 238.36,
    "duration": 3.519
  },
  {
    "text": "¿Qué estabas pensando?",
    "start": 246.599,
    "duration": 3.36
  },
  {
    "text": "¿Tú qué pensabas? Detención ahora.",
    "start": 248.0,
    "duration": 3.799
  },
  {
    "text": "Detención siempre.",
    "start": 249.959,
    "duration": 3.12
  },
  {
    "text": "Bien hecho, sabelo todo.",
    "start": 251.799,
    "duration": 3.601
  },
  {
    "text": "Es un idiota.",
    "start": 253.079,
    "duration": 3.88
  },
  {
    "text": "Ganarás con el discurso.",
    "start": 255.4,
    "duration": 5.292
