[
  {
    "text": "Pelu, sinin, ¿dónde estamos, gey?",
    "start": 1.28,
    "duration": 2.599
  },
  {
    "text": "Sígueme y cállate, Jonathan.",
    "start": 2.72,
    "duration": 2.76
  },
  {
    "text": "Llevamos dando vueltas media hora.",
    "start": 3.879,
    "duration": 3.0
  },
  {
    "text": "A ver, Jonathan, ¿quién es el guía?",
    "start": 5.48,
    "duration": 2.76
  },
  {
    "text": "Tú, gey. Pero nada más eres el guía",
    "start": 6.879,
    "duration": 2.76
  },
  {
    "text": "porque se murió tu amigo y aparte eres",
    "start": 8.24,
    "duration": 2.0
  },
  {
    "text": "pésimo.",
    "start": 9.639,
    "duration": 2.201
  },
  {
    "text": "Por aquí hay unicornios.",
    "start": 10.24,
    "duration": 2.439
  },
  {
    "text": "Cállate, Ortega.",
    "start": 11.84,
    "duration": 2.719
  },
  {
    "text": "Ándale, por aquí hay unicornios.",
    "start": 12.679,
    "duration": 3.241
  },
  {
    "text": "Ya, Pelusin, ¿en dónde estamos, gey?",
    "start": 14.559,
    "duration": 2.8
  },
  {
    "text": "¿Dónde están los unicornios?",
    "start": 15.92,
    "duration": 2.24
  },
  {
