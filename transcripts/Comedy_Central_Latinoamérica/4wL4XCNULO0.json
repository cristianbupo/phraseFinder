  {
    "text": "A pelar bananes.",
    "start": 221.519,
    "duration": 1.961
  },
  {
    "text": "Eso.",
    "start": 222.959,
    "duration": 1.64
  },
  {
    "text": "Con ganas, irmita.",
    "start": 223.48,
    "duration": 2.44
  },
  {
    "text": "¡Caraj! Por cierto, hablaron del",
    "start": 224.599,
    "duration": 2.881
