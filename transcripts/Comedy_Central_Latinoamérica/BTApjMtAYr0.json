[
  {
    "text": "Entonces llego al antro y el de la",
    "start": 3.08,
    "duration": 3.44
  },
  {
    "text": "puerta me dice, \"Pásele, señor.\"",
    "start": 4.839,
    "duration": 2.44
  },
  {
    "text": "¿Te dejaron entrar?",
    "start": 6.52,
    "duration": 1.56
  },
  {
    "text": "Sí, sí. Enfriega.",
    "start": 7.279,
    "duration": 1.761
  },
  {
    "text": "Y te dijeron, \"Señor,",
    "start": 8.08,
    "duration": 2.479
  },
  {
    "text": "sí, pásele, señor\", me dijeron.",
    "start": 9.04,
    "duration": 2.92
  },
  {
    "text": "\"¿Estás seguro que no se confundieron y",
    "start": 10.559,
    "duration": 2.96
  },
  {
    "text": "pensaron que eras, no sé, el que limpia",
    "start": 11.96,
